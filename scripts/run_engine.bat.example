@echo off
rem Starts the engine inside WSL, so a Windows GUI (Fritz, Cute Chess, ...) can load it as a UCI engine.
rem Copy to run_engine.bat and set TIKI_APP and TIKI_EVALFILE, or set them in the environment, to the WSL
rem paths of tiki_app and the network, e.g.
rem   set TIKI_APP=/mnt/c/Users/<you>/develop/tiki/build/engine/app/tiki_app
rem   set TIKI_EVALFILE=/mnt/f/tiki/nets/tiki-11.nnue

if "%TIKI_APP%"=="" (
    echo Set TIKI_APP to the WSL path of tiki_app. 1>&2
    exit /b 1
)
if "%TIKI_EVALFILE%"=="" (
    echo Set TIKI_EVALFILE to the WSL path of the network. 1>&2
    exit /b 1
)

rem Windows environment variables don't reach WSL by default, so pass the network's path explicitly.
wsl env TIKI_EVALFILE="%TIKI_EVALFILE%" "%TIKI_APP%"
